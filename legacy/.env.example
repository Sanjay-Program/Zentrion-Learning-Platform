# Zentrion Learntech — environment template
# Copy to .env and fill in values. Never commit .env or real secrets.

# --- Application ---
APP_ENV=development            # development | testing | staging | production
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./data/zentrion.db

# --- Authentication ---
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_COOKIE_AGE_DAYS=30
# Optional: fixed seed for demo TOTP is NOT supported; MFA secrets are per-user.

# --- Email (SMTP). Leave unset to log emails to console in development. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Zentrion Learntech <noreply@example.com>

# --- AI provider (OpenAI-compatible). Leave unset to show the setup state. ---
AI_PROVIDER=openai_compatible   # openai_compatible | none
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_DEFAULT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_TOKENS_PER_DAY=50000

# --- Payments (Stripe). Leave unset to show the setup state. ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Storage. local = ./data/storage (dev). s3 = object storage (prod). ---
STORAGE_BACKEND=local
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_AWS_ACCESS_KEY_ID=
STORAGE_AWS_SECRET_ACCESS_KEY=

# --- Cybersecurity lab runtime ---
# Simulated labs run in-process with synthetic data and require no credentials.
# A real sandboxed container runtime can be plugged in via the LabExecutor port.
LAB_EXECUTOR=simulated
LAB_MAX_SESSION_MINUTES=120
