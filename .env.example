# Zentrion Learntech — environment template
# Copy to .env for local development. Never commit real secrets.
# In production (Cloudflare), set these as Pages secrets via `wrangler pages secret put <name>`.

# --- Application ---
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:3000

# --- Database ---
# Local development: file-based libsql (pure JS, no native deps)
DATABASE_URL=file:./data/zentrion.db
# Production (D1) uses the Cloudflare `DB` binding automatically.

# --- Email (SMTP). Unset = log to console in development ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Zentrion Learntech <noreply@example.com>"

# --- AI provider (OpenAI-compatible) ---
AI_PROVIDER=none
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_DEFAULT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_TOKENS_PER_DAY=50000

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Storage: local (./data/storage) in dev, r2 in production ---
STORAGE_BACKEND=local

# --- Cybersecurity lab runtime (simulated = safe in-process sandbox) ---
LAB_EXECUTOR=simulated
LAB_MAX_SESSION_MINUTES=120

# --- Session ---
SESSION_COOKIE_AGE_DAYS=30
